# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
# Public origin of the web app (the API is reached through its /api proxy).
APP_ORIGIN=http://localhost:3000

# App connects as a least-privilege role (no table ownership, no BYPASSRLS).
DATABASE_URL=postgres://ss_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:54329/secret_santa
# Migrations run as the owner role.
MIGRATION_DATABASE_URL=postgres://ss_owner:dev-only-owner-password@127.0.0.1:54329/secret_santa
# Password set for ss_app by the first migration run.
APP_DB_PASSWORD=CHANGE_ME_APP_PASSWORD

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ASSIGNMENT_KEY=

# Development only: enables /auth/dev-login so you can test without Google. Refused when NODE_ENV=production.
DEV_LOGIN=false
